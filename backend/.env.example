# Google Gemini API Key (Get yours from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Live API Model
MODEL_NAME=gemini-3.1-flash-live-preview

# Neon PostgreSQL Database Connection String
DATABASE_URL=postgresql://user:password@ep-your-neon-host.region.aws.neon.tech/neondb?sslmode=require

# JWT Secret Key for Session Authentication (Generate a random 32+ character string)
JWT_SECRET=your_super_secret_jwt_key_here

# Allowed CORS Origins
CORS_ORIGINS=*
